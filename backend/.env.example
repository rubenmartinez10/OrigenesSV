# Copia este archivo como .env para correr el backend fuera de Docker (npm run dev)
PORT=4000
DATABASE_URL=postgres://origenes:origenes@localhost:5433/origenes
JWT_SECRET=cambia-este-secreto
CORS_ORIGIN=http://localhost:5173
# Modo demo: permite adelantar el reloj simulado y «Restablecer datos» desde el inicio de sesión
DEMO=true
# Carpeta con los .sql de la BD (para «Restablecer datos»)
SQL_DIR=../database/init
# Solo con HTTPS: la cookie de sesión viaja únicamente por conexiones seguras
COOKIE_SECURE=false
